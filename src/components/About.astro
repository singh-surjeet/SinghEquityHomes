---
const bullets = [
  'Established BTL portfolio across the UK',
  'Actively pursuing planning uplift opportunities',
  'Joint venture capability with leading development programmes',
  "A straightforward approach to every deal — no jargon, no games",
  'Fully registered with Companies House',
];
---

<section id="about" class="py-16 md:py-24 px-[5%]">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 items-center max-w-[1200px] mx-auto">

    <!-- Image block -->
    <div class="relative fade-up">
      <div class="w-full aspect-[4/5] bg-navy rounded-[2px] overflow-hidden">
        <div
          class="w-full h-full flex items-center justify-center"
          style="background: linear-gradient(160deg, #243A5E, #1A2E4A)"
        >
          <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" style="opacity:0.3">
            <rect x="20" y="100" width="40" height="80" fill="white"/>
            <rect x="70" y="70" width="50" height="110" fill="white"/>
            <rect x="130" y="50" width="50" height="130" fill="white"/>
            <line x1="10" y1="180" x2="190" y2="180" stroke="white" stroke-width="3"/>
            <polygon points="85,20 100,5 115,20" fill="#B8973A"/>
            <line x1="100" y1="5" x2="100" y2="70" stroke="#B8973A" stroke-width="2"/>
          </svg>
        </div>
      </div>
      <!-- Gold badge -->
      <div class="absolute -bottom-4 right-0 md:-bottom-6 md:-right-6 bg-gold text-navy p-6 rounded-[2px] text-center min-w-[140px]">
        <span class="font-serif text-[2rem] font-semibold block leading-none">Ltd</span>
        <div class="text-[0.7rem] font-semibold uppercase tracking-[0.1em] mt-1.5 opacity-80">
          Companies House<br />Registered
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="pr-4 fade-up">
      <p class="section-eyebrow">About SinghEquity Homes</p>
      <h2 class="section-title">A property business built on strategy, not speculation</h2>
      <p class="section-sub mb-8">
        We're a UK property investment and development business, built on a foundation in buy-to-let and now
        pushing further into SME development — sourcing land, securing planning uplift, and seeing residential
        schemes through ourselves rather than handing them off.
      </p>
      <blockquote class="border-l-2 border-gold pl-5 mb-8 max-w-[480px]">
        <p class="font-serif text-[1.15rem] text-navy leading-[1.6] italic">
          We'd rather do a handful of deals properly than take on more than we can look after.
        </p>
      </blockquote>
      <ul class="flex flex-col gap-3.5 mb-10 list-none p-0">
        {bullets.map((item) => (
          <li class="flex items-start gap-3 text-[0.95rem] text-text-mid">
            <span class="block w-[18px] h-[2px] bg-gold mt-[0.65em] flex-shrink-0"></span>
            {item}
          </li>
        ))}
      </ul>
      <a href="#contact" class="btn-primary">Work With Us</a>
    </div>

  </div>
</section>
